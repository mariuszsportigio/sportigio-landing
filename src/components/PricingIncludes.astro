---
import {
  defaultLanguage,
  getTranslations,
  type Language,
} from "../i18n";
import newsIcon from "lucide-static/icons/newspaper.svg?raw";
import sparklesIcon from "lucide-static/icons/sparkles.svg?raw";
import ticketIcon from "lucide-static/icons/ticket.svg?raw";
import chartIcon from "lucide-static/icons/bar-chart-3.svg?raw";
import globeIcon from "lucide-static/icons/globe.svg?raw";
import trophyIcon from "lucide-static/icons/trophy.svg?raw";
import layoutTemplateIcon from "lucide-static/icons/layout-template.svg?raw";
import menuIcon from "lucide-static/icons/menu.svg?raw";

interface Props {
  lang?: Language;
  section?: "pricing" | "pricingWebsite";
}

const { lang = defaultLanguage, section = "pricing" } = Astro.props as Props;

const translations = getTranslations(lang) as any;
const fallbackTranslations =
  lang === defaultLanguage
    ? translations
    : (getTranslations(defaultLanguage) as any);

const sectionCopy = (translations?.pages?.[section]?.includes ?? {}) as any;
const fallbackCopy = (fallbackTranslations?.pages?.[section]?.includes ?? {}) as any;

const title =
  sectionCopy.title ?? fallbackCopy.title ?? "Każdy pakiet zawiera";
const subtitle =
  sectionCopy.subtitle ??
  fallbackCopy.subtitle ??
  "Poznaj funkcje dostępne w platformie Sportigio";

const iconSvgs: Record<string, string> = {
  news: newsIcon,
  branding: sparklesIcon,
  tickets: ticketIcon,
  analytics: chartIcon,
  domain: globeIcon,
  sponsors: trophyIcon,
  homepage: layoutTemplateIcon,
  menu: menuIcon,
};

const resolvedItems =
  Array.isArray(sectionCopy.items) && sectionCopy.items.length > 0
    ? sectionCopy.items
    : (fallbackCopy.items ?? []);
---

<section class="py-14 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold text-[#0B2360]">{title}</h2>
      <p class="mt-3 text-base text-gray-600">{subtitle}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        resolvedItems.map((item: any, index: number) => {
          const icon = iconSvgs[item?.id] ?? iconSvgs.news;

          return (
            <div
              class="group h-full rounded-2xl bg-[#F6F8FD] border border-[#0B2360]/10 p-6 shadow-sm hover:shadow-md transition-all duration-200"
            >
              <div
                class="w-12 h-12 rounded-xl bg-white border border-[#0B2360]/10 flex items-center justify-center text-[#0B2360] mb-4 shadow-[0_8px_24px_rgba(11,35,96,0.06)] [&>svg]:w-6 [&>svg]:h-6 [&>svg]:stroke-[1.8] transition-colors duration-200 group-hover:bg-[#0B2360] group-hover:text-white group-hover:border-[#0B2360]/20"
                aria-hidden="true"
                set:html={icon}
              />
              <h3 class="text-lg font-semibold text-[#0B2360] mb-2">
                {item?.title ?? `Funkcja ${index + 1}`}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                {item?.description ?? ""}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
