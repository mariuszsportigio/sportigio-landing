---
import {
  defaultLanguage,
  getTranslations,
  localizeHref,
  type Language,
} from "../i18n";
import crownIcon from "lucide-static/icons/crown.svg?raw";
import arrowRightIcon from "lucide-static/icons/arrow-right.svg?raw";

interface Props {
  lang?: Language;
  title?: string;
  subtitle?: string;
  cta?: string;
  ctaHref?: string;
  badge?: string;
}

const {
  lang = defaultLanguage,
  title,
  subtitle,
  cta,
  ctaHref,
  badge,
} = Astro.props as Props;

const translations = getTranslations(lang) as any;
const fallbackTranslations =
  lang === defaultLanguage
    ? translations
    : (getTranslations(defaultLanguage) as any);

const sectionCopy = (translations?.pages?.pricing?.addons ?? {}) as any;
const fallbackCopy = (fallbackTranslations?.pages?.pricing?.addons ??
  {}) as any;

const resolvedTitle =
  title ??
  sectionCopy.title ??
  fallbackCopy.title ??
  "Potrzebujesz więcej? Pakiet Champion";
const resolvedSubtitle =
  subtitle ??
  sectionCopy.subtitle ??
  fallbackCopy.subtitle ??
  "Chcesz wsparcia, dedykowanego opiekuna lub rozwiązań szytych na miarę? Porozmawiajmy o pakiecie Champion – stworzymy ofertę idealnie dopasowaną do Twojej organizacji.";
const resolvedCta =
  cta ?? sectionCopy.cta ?? fallbackCopy.cta ?? "Umów konsultację";
const resolvedCtaHref = localizeHref(
  ctaHref ??
    sectionCopy.ctaHref ??
    fallbackCopy.ctaHref ??
    "https://sportigio.com/join",
  lang,
);

const resolvedBadge =
  badge ?? sectionCopy.badge ?? fallbackCopy.badge ?? "Pakiet Champion";
---

<section class="relative overflow-hidden py-20 bg-[#0B1F46]">
  <div
    class="absolute inset-0 bg-gradient-to-br from-[#0B2360] via-[#00052E] to-[#0B2360]"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -left-16 -top-16 h-48 w-48 rounded-full bg-[#01DFEC]/10 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -right-10 bottom-0 h-52 w-52 rounded-full bg-[#EA36E1]/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <div
      class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white/5 border border-white/10"
    >
      <span
        class="w-7 h-7 text-[#01DFEC] [&>svg]:w-full [&>svg]:h-full [&>svg]:stroke-[2]"
        aria-hidden="true"
        set:html={crownIcon}
      />
      <span class="sr-only">{resolvedBadge}</span>
    </div>

    <h2 class="mt-6 text-3xl sm:text-4xl font-bold text-white leading-tight">
      {resolvedTitle}
    </h2>
    <p class="mt-4 text-lg text-white/80 max-w-3xl mx-auto">
      {resolvedSubtitle}
    </p>

    <div class="mt-8 flex justify-center">
      <a
        href={resolvedCtaHref}
        class="inline-flex items-center gap-2 rounded-full bg-[#01DFEC] px-6 sm:px-8 py-3 text-base sm:text-lg font-semibold text-[#0B2360] transition transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#01DFEC]"
      >
        {resolvedCta}
        <span
          class="w-5 h-5 text-[#0B2360] [&>svg]:w-full [&>svg]:h-full"
          aria-hidden="true"
          set:html={arrowRightIcon}
        />
      </a>
    </div>
  </div>
</section>
