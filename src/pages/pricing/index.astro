---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PricingTable from "../../components/PricingTable.astro";
import PricingAddOns from "../../components/PricingAddOns.astro";
import TrustedClubsSection from "../../components/TrustedClubsSection.astro";
import PricingIncludes from "../../components/PricingIncludes.astro";
import RevenueCalculator from "../../components/RevenueCalculator.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import pricingCopy from "../../data/pricing-copy.json";
import pricingAmounts from "../../data/pricing-amounts.json";
import {
  defaultLanguage,
  getTranslations,
  localizeHref,
  type Language,
} from "../../i18n";

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props as Props;

const translations = getTranslations(lang) as any;
const fallbackTranslations =
  lang === defaultLanguage
    ? translations
    : (getTranslations(defaultLanguage) as any);

const pricingText =
  translations?.pricing ?? fallbackTranslations?.pricing ?? {};
const fallbackPricingText = fallbackTranslations?.pricing ?? {};
const pageCopy =
  translations?.pages?.pricing ?? fallbackTranslations?.pages?.pricing ?? {};
const fallbackPageCopy = fallbackTranslations?.pages?.pricing ?? {};

const metaTitle =
  pageCopy.meta?.title ??
  fallbackPageCopy.meta?.title ??
  "Cennik - Sportigio | Wybierz idealny pakiet dla swojego klubu";

const heroTitle =
  pricingText.title ?? "Wybierz idealny pakiet dla swojego klubu";
const heroSubtitle =
  pricingText.subtitle ??
  "Proste, przejrzyste ceny. Bez ukrytych kosztów. Zmień pakiet w każdej chwili.";
const currencyLabel = pricingText.currency ?? "Waluta:";
const monthlyLabel = pricingText.monthly ?? "Miesięcznie";
const yearlyLabel = pricingText.yearly ?? "Rocznie";
const saveBadgeText = pricingText.save_badge ?? "Oszczędź do 20%";
const detailedComparisonTitle =
  pricingText.detailed_comparison ?? "Szczegółowe porównanie funkcji";
const detailedComparisonSubtitle =
  pricingText.detailed_comparison_subtitle ?? "Szczegółowe zestawienie funkcji";
const featureColumnLabel = pricingText.feature_column_label ?? "Funkcja";
const freeLabel = pricingText.free_label ?? "Free";
const proLabel = pricingText.pro_label ?? "Pro";
const championLabel = pricingText.champion_label ?? "Champion";
const expandLabel = pricingText.expand_pricing ?? "Rozwiń pełny cennik";
const collapseLabel = pricingText.collapse_pricing ?? "Zwiń cennik";
const faqTitle = pricingText.faq_title ?? "Masz pytania?";
const faqSubtitle =
  pricingText.faq_subtitle ??
  "Jesteśmy tutaj, aby pomóc Twojemu klubowi rozwijać się online.";
const faqButtonLabel = pricingText.faq_button ?? "Często zadawane pytania";
const contactUsLabel =
  translations?.common?.contact_us ??
  fallbackTranslations?.common?.contact_us ??
  "Skontaktuj się z nami";

const premiumCopy = pageCopy.premium ?? fallbackPageCopy.premium ?? {};
const premiumHighlights =
  Array.isArray(premiumCopy.highlights) && premiumCopy.highlights.length > 0
    ? premiumCopy.highlights
    : (fallbackPageCopy.premium?.highlights ?? []);
const premiumReceiveItems =
  Array.isArray(premiumCopy.receiveItems) && premiumCopy.receiveItems.length > 0
    ? premiumCopy.receiveItems
    : (fallbackPageCopy.premium?.receiveItems ?? []);
const premiumButtons =
  premiumCopy.buttons ?? fallbackPageCopy.premium?.buttons ?? {};
const premiumPriceLabel =
  premiumCopy.priceLabel ?? fallbackPageCopy.premium?.priceLabel ?? "";
const premiumPriceSubLabel =
  premiumCopy.priceSubLabel ?? fallbackPageCopy.premium?.priceSubLabel ?? "";
const premiumReceiveTitle =
  premiumCopy.receiveTitle ?? fallbackPageCopy.premium?.receiveTitle ?? "";
const websiteAddonCopy =
  pageCopy.websiteAddon ?? fallbackPageCopy.websiteAddon ?? {};
const websiteAddonBadge = websiteAddonCopy.badge ?? "Add-on";
const websiteAddonTitle =
  websiteAddonCopy.title ?? "Profesjonalna strona WWW";
const websiteAddonDescription =
  websiteAddonCopy.description ??
  "W pełni zintegrowana z platformą, responsywna i łatwa w obsłudze.";
const websiteAddonPriceLead =
  websiteAddonCopy.priceLead ?? "Już od";
const websiteAddonPriceHighlight =
  websiteAddonCopy.priceHighlight ?? "199 zł";
const websiteAddonPriceSuffix =
  websiteAddonCopy.priceSuffix ?? "miesięcznie.";
const websiteAddonCta =
  websiteAddonCopy.cta ?? "Zobacz pakiety strony WWW";
const websiteAddonHref = localizeHref("/pricing/website", lang);

type LocalizedText = string | Record<string, string>;
type ColumnKey = "free" | "pro" | "champion";
type CellValue =
  | "check"
  | "dash"
  | { label: LocalizedText; className?: string };

type FeatureRow = {
  key: string;
  label: LocalizedText;
  tooltip?: LocalizedText;
  values: Record<ColumnKey, CellValue>;
};

const resolveText = (value: LocalizedText): string => {
  if (typeof value === "string") return value;
  return (
    value?.[lang] ??
    value?.[defaultLanguage] ??
    value?.en ??
    Object.values(value ?? {})[0] ??
    ""
  );
};

const comparisonColumns: { key: ColumnKey; label: string; accent: string }[] =
  [
    { key: "free", label: freeLabel, accent: "text-emerald-500" },
    { key: "pro", label: proLabel, accent: "text-[#0B2360]" },
    { key: "champion", label: championLabel, accent: "text-[#01DFEC]" },
  ];

const comparisonBaseFeatures: FeatureRow[] = [
  {
    key: "news",
    label: {
      pl: "Aktualności i treści",
      en: "News & content",
      es: "Noticias y contenido",
      de: "News & Inhalte",
    },
    tooltip: {
      pl: "Publikuj aktualności, wyniki i multimedia bezpośrednio z panelu.",
      en: "Publish news, results and media directly from the dashboard.",
      es: "Publica noticias, resultados y medios desde el panel.",
      de: "Veröffentliche News, Ergebnisse und Medien direkt aus dem Panel.",
    },
    values: { free: "check", pro: "check", champion: "check" },
  },
  {
    key: "push",
    label: {
      pl: "Powiadomienia Push",
      en: "Push notifications",
      es: "Notificaciones push",
      de: "Push-Benachrichtigungen",
    },
    tooltip: {
      pl: "Wysyłaj alerty do kibiców o nowych postach, wynikach czy zmianach.",
      en: "Send alerts to fans about new posts, scores or schedule changes.",
      es: "Envía alertas a los fans sobre nuevas publicaciones o resultados.",
      de: "Sende Alerts an Fans zu neuen Beiträgen, Ergebnissen oder Änderungen.",
    },
    values: { free: "dash", pro: "check", champion: "check" },
  },
  {
    key: "newsletter",
    label: {
      pl: "Newsletter",
      en: "Newsletter",
      es: "Boletín",
      de: "Newsletter",
    },
    tooltip: {
      pl: "Zautomatyzowane kampanie email z wynikami i treściami klubu.",
      en: "Automated email campaigns with club news and results.",
      es: "Campañas de email automatizadas con noticias del club.",
      de: "Automatisierte E-Mail-Kampagnen mit Club-News und Ergebnissen.",
    },
    values: { free: "dash", pro: "check", champion: "check" },
  },
  {
    key: "segments",
    label: {
      pl: "Segmentacja bazy",
      en: "Audience segmentation",
      es: "Segmentación de audiencia",
      de: "Zielgruppensegmentierung",
    },
    tooltip: {
      pl: "Twórz grupy odbiorców i kieruj treści do konkretnych kibiców.",
      en: "Create audience groups and target content to specific fans.",
      es: "Crea grupos de audiencia y dirige contenido a fans específicos.",
      de: "Erstelle Zielgruppen und sende Inhalte gezielt an Fans.",
    },
    values: { free: "dash", pro: "check", champion: "check" },
  },
  {
    key: "sponsors",
    label: {
      pl: "Moduł Sponsorzy",
      en: "Sponsors module",
      es: "Módulo de patrocinadores",
      de: "Sponsoren-Modul",
    },
    tooltip: {
      pl: "Dedykowane miejsca na ekspozycję partnerów i aktywacje sponsorskie.",
      en: "Dedicated placements for partner exposure and sponsor activations.",
      es: "Espacios dedicados para exponer socios y activaciones de patrocinio.",
      de: "Plätze für Partner-Sichtbarkeit und Sponsoren-Aktivierungen.",
    },
    values: { free: "dash", pro: "check", champion: "check" },
  },
  {
    key: "analytics",
    label: {
      pl: "Pełna analityka",
      en: "Full analytics",
      es: "Analítica completa",
      de: "Vollständige Analytik",
    },
    tooltip: {
      pl: "Raporty o aktywności kibiców, kampaniach i zaangażowaniu.",
      en: "Reports on fan activity, campaigns and engagement.",
      es: "Informes sobre actividad de fans, campañas y engagement.",
      de: "Berichte zu Fanaktivität, Kampagnen und Engagement.",
    },
    values: { free: "dash", pro: "check", champion: "check" },
  },
];

const comparisonExpandedFeatures: FeatureRow[] = [
  {
    key: "support-time",
    label: {
      pl: "Czas odpowiedzi support",
      en: "Support response time",
      es: "Tiempo de respuesta de soporte",
      de: "Support-Reaktionszeit",
    },
    tooltip: {
      pl: "Priorytet obsługi zgłoszeń i wsparcia technicznego.",
      en: "Priority handling of tickets and technical support.",
      es: "Gestión prioritaria de tickets y soporte técnico.",
      de: "Priorisierte Bearbeitung von Tickets und technischem Support.",
    },
    values: {
      free: { label: "72h", className: "text-sm text-gray-600 font-medium" },
      pro: {
        label: "24h",
        className: "text-sm font-semibold text-[#3242d6]",
      },
      champion: {
        label: "12h",
        className: "text-sm font-bold text-[#0B2360]",
      },
    },
  },
  {
    key: "custom-modules",
    label: {
      pl: "Custom moduły",
      en: "Custom modules",
      es: "Módulos a medida",
      de: "Individuelle Module",
    },
    tooltip: {
      pl: "Projektujemy dodatkowe moduły szyte na miarę potrzeb klubu.",
      en: "We design extra modules tailored to the club’s needs.",
      es: "Diseñamos módulos extra a medida de tu club.",
      de: "Wir bauen zusätzliche Module nach Bedarf des Clubs.",
    },
    values: { free: "dash", pro: "dash", champion: "check" },
  },
  {
    key: "sla",
    label: {
      pl: "Gwarancja SLA",
      en: "SLA guarantee",
      es: "Garantía SLA",
      de: "SLA-Garantie",
    },
    tooltip: {
      pl: "Umowne czasy przywrócenia usług i dostępność platformy.",
      en: "Contracted restoration times and platform availability.",
      es: "Tiempos de restauración y disponibilidad acordados.",
      de: "Vertraglich zugesicherte Wiederherstellungszeiten und Verfügbarkeit.",
    },
    values: { free: "dash", pro: "dash", champion: "check" },
  },
  {
    key: "account-manager",
    label: {
      pl: "Dedykowany opiekun",
      en: "Dedicated account manager",
      es: "Account manager dedicado",
      de: "Dedizierter Ansprechpartner",
    },
    tooltip: {
      pl: "Osobisty opiekun prowadzący wdrożenie i rozwój komunikacji.",
      en: "Personal manager guiding onboarding and ongoing communication.",
      es: "Responsable personal para onboarding y comunicación continua.",
      de: "Persönlicher Ansprechpartner für Onboarding und Weiterentwicklung.",
    },
    values: { free: "dash", pro: "dash", champion: "check" },
  },
];
---

<Layout title={metaTitle}>
  <!-- Fixed Navigation -->
  <Navbar lang={lang} activePage="pricing" />

  <!-- Main Content -->
  <main class="pt-16">
    <!-- Hero Section for Pricing - Light -->
    <section
      class="hero-gradient relative bg-gradient-to-br from-gray-50 to-white pt-16 pb-4 overflow-hidden"
    >
      <!-- Background pattern (CSS grid to avoid JSX parsing issues) -->
      <div class="absolute inset-0 hero-grid opacity-30"></div>

      <!-- Content -->
      <div class="relative max-w-4xl mx-auto px-4 text-center">
        <h1 class="text-3xl lg:text-5xl font-bold text-[#0B2360] mb-4">
          {heroTitle}
        </h1>
        <p class="text-lg text-gray-600 mb-2 max-w-2xl mx-auto">
          {heroSubtitle}
        </p>
      </div>
    </section>

    <TrustedClubsSection lang={lang} />

    <!-- Pricing Section -->
    <section class="py-0 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 pt-12 pb-4">
        <div class="flex items-center justify-center flex-wrap gap-4 text-center">
          <div class="flex items-center gap-3">
            <span class="text-gray-700 font-medium">{currencyLabel}</span>
            <select
              id="currency-select"
              class="bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-700"
            >
              <option value="PLN">PLN</option>
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
            </select>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-gray-700 font-medium">{monthlyLabel}</span>
            <div class="relative">
              <input type="checkbox" id="billing-toggle" class="sr-only" />
              <label
                for="billing-toggle"
                class="flex items-center cursor-pointer"
              >
                <div class="relative">
                  <div class="block bg-gray-300 w-14 h-8 rounded-full"></div>
                  <div
                    class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition transform"
                  >
                  </div>
                </div>
              </label>
            </div>
            <span class="text-gray-700 font-medium">{yearlyLabel}</span>
            <span
              class="bg-[#01DFEC] text-[#0B2360] px-3 py-1 rounded-full text-sm font-semibold"
            >
              {saveBadgeText}
            </span>
          </div>
        </div>
      </div>

      <PricingTable lang={lang} />
    </section>

    <PricingIncludes lang={lang} />

    <RevenueCalculator lang={lang} />

    <!-- Detailed Comparison Table -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-[#0B2360] mb-2">
            {detailedComparisonTitle}
          </h2>
          <p class="text-gray-500 text-base">{detailedComparisonSubtitle}</p>
        </div>

        <div
          class="bg-white rounded-[28px] border border-gray-100 shadow-[0_24px_70px_rgba(11,35,96,0.08)] overflow-hidden"
        >
          <div class="overflow-x-auto" data-pricing-table-wrapper>
            <table
              class="w-full min-w-[720px] table-fixed border-separate border-spacing-0"
            >
            <thead class="bg-gray-50/70">
              <tr class="text-sm uppercase tracking-wide text-gray-500">
                <th class="text-left py-5 px-6 font-semibold text-gray-700">
                  {featureColumnLabel}
                </th>
                {comparisonColumns.map((col) => (
                  <th
                    class="text-center py-5 px-4 font-semibold text-[#0B2360] text-sm"
                  >
                    {col.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {comparisonBaseFeatures.map((feature) => (
                <tr class="hover:bg-gray-50/60 transition-colors">
                  <td class="py-4 px-6 text-gray-800 font-medium">
                    <div class="flex items-center gap-2">
                      <span>{resolveText(feature.label)}</span>
                      {
                        feature.tooltip && (
                          <div class="relative group">
                            <svg
                              class="w-4 h-4 text-gray-300 group-hover:text-[#0B2360] transition-colors cursor-help"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                              ></path>
                            </svg>
                            <div
                              class="pointer-events-none opacity-0 group-hover:opacity-100 absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-64 rounded-xl bg-[#0B2360] text-white text-xs px-3 py-2 shadow-lg transition"
                            >
                              {resolveText(feature.tooltip)}
                            </div>
                          </div>
                        )
                      }
                    </div>
                  </td>
                  {comparisonColumns.map((col) => {
                    const cellValue = feature.values[col.key];
                    const isObjectValue =
                      typeof cellValue === "object" && cellValue !== null;

                    return (
                      <td class="py-4 px-4 text-center">
                        {
                          cellValue === "check" ? (
                            <span
                              class={`inline-flex h-6 w-6 items-center justify-center rounded-full bg-gray-50 shadow-[0_6px_14px_rgba(11,35,96,0.08)] ${col.accent}`}
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2.5"
                                  d="M5 13l4 4L19 7"
                                ></path>
                              </svg>
                            </span>
                          ) : cellValue === "dash" ? (
                            <span class="text-gray-300 text-lg">—</span>
                          ) : isObjectValue ? (
                            <span
                              class={`text-sm font-semibold text-gray-700 ${cellValue.className ?? ""}`}
                            >
                              {resolveText(cellValue.label)}
                            </span>
                          ) : (
                            <span class="text-sm font-semibold text-gray-700">
                              {cellValue as string}
                            </span>
                          )
                        }
                      </td>
                    );
                  })}
                </tr>
              ))}

              {comparisonExpandedFeatures.map((feature) => (
                <tr
                  class="hover:bg-gray-50/60 transition-colors hidden"
                  data-extra-row
                >
                  <td class="py-4 px-6 text-gray-800 font-medium">
                    <div class="flex items-center gap-2">
                      <span>{resolveText(feature.label)}</span>
                      {
                        feature.tooltip && (
                          <div class="relative group">
                            <svg
                              class="w-4 h-4 text-gray-300 group-hover:text-[#0B2360] transition-colors cursor-help"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                              ></path>
                            </svg>
                            <div
                              class="pointer-events-none opacity-0 group-hover:opacity-100 absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-64 rounded-xl bg-[#0B2360] text-white text-xs px-3 py-2 shadow-lg transition"
                            >
                              {resolveText(feature.tooltip)}
                            </div>
                          </div>
                        )
                      }
                    </div>
                  </td>
                  {comparisonColumns.map((col) => {
                    const cellValue = feature.values[col.key];
                    const isObjectValue =
                      typeof cellValue === "object" && cellValue !== null;

                    return (
                      <td class="py-4 px-4 text-center">
                        {
                          cellValue === "check" ? (
                            <span
                              class={`inline-flex h-6 w-6 items-center justify-center rounded-full bg-gray-50 shadow-[0_6px_14px_rgba(11,35,96,0.08)] ${col.accent}`}
                            >
                              <svg
                                class="w-4 h-4"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2.5"
                                  d="M5 13l4 4L19 7"
                                ></path>
                              </svg>
                            </span>
                          ) : cellValue === "dash" ? (
                            <span class="text-gray-300 text-lg">—</span>
                          ) : isObjectValue ? (
                            <span
                              class={`text-sm font-semibold text-gray-700 ${cellValue.className ?? ""}`}
                            >
                              {resolveText(cellValue.label)}
                            </span>
                          ) : (
                            <span class="text-sm font-semibold text-gray-700">
                              {cellValue as string}
                            </span>
                          )
                        }
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <div class="bg-gray-50/80 px-6 py-5 flex justify-center">
            <button
              type="button"
              class="inline-flex items-center gap-2 rounded-full bg-[#1e46ff] text-white px-5 py-3 text-sm font-semibold shadow-[0_12px_30px_rgba(30,70,255,0.28)] transition hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#01DFEC]"
              data-pricing-toggle
              data-label-collapsed={expandLabel}
              data-label-expanded={collapseLabel}
              aria-expanded="false"
            >
              <span data-label>{expandLabel}</span>
              <span
                data-icon
                class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-white/15"
              >
                <svg
                  class="w-3 h-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 9l6 6 6-6"
                  ></path>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.querySelector("[data-pricing-toggle]");
        const label = toggle?.querySelector("[data-label]");
        const icon = toggle?.querySelector("[data-icon]");
        const extraRows = Array.from(
          document.querySelectorAll("[data-extra-row]"),
        );

        if (!toggle || !label || !icon || extraRows.length === 0) return;

        const collapsed =
          toggle.getAttribute("data-label-collapsed") ||
          "Rozwiń pełny cennik";
        const expanded =
          toggle.getAttribute("data-label-expanded") || "Zwiń cennik";

        const setState = (isExpanded) => {
          extraRows.forEach((row) => {
            if (isExpanded) {
              row.classList.remove("hidden");
              requestAnimationFrame(() => row.classList.add("is-visible"));
            } else {
              if (row.classList.contains("hidden")) return;
              row.classList.remove("is-visible");
              row.addEventListener(
                "transitionend",
                () => row.classList.add("hidden"),
                { once: true },
              );
            }
          });
          label.textContent = isExpanded ? expanded : collapsed;
          toggle.setAttribute("aria-expanded", isExpanded ? "true" : "false");
          icon.style.transform = isExpanded ? "rotate(180deg)" : "rotate(0deg)";
        };

        let isOpen = false;
        setState(isOpen);

        toggle.addEventListener("click", () => {
          isOpen = !isOpen;
          setState(isOpen);
        });
      });
    </script>

    <!-- Add-on Section -->
    <PricingAddOns lang={lang} />

    <!-- Premium Package Details (hidden per request) -->
    <section class="py-16 bg-white hidden">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
