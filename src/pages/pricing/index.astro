<style>
  /* Hero gradient smooth transitions */
  .hero-gradient::before,
  .hero-gradient::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 60px;
    pointer-events: none;
    z-index: 1;
  }

  .hero-gradient::before {
    top: 0;
    background: linear-gradient(to bottom, white, rgba(255, 255, 255, 0));
  }

  .hero-gradient::after {
    bottom: 0;
    background: linear-gradient(to top, white, rgba(255, 255, 255, 0));
  }

  .hero-gradient > * {
    position: relative;
    z-index: 2;
  }

  /* Billing toggle styles */
  #billing-toggle:checked + label .dot {
    transform: translateX(24px);
    background-color: #01dfec;
  }

  /* Only color the toggle track, not the whole label wrapper */
  #billing-toggle:checked + label > div > div:first-child {
    background-color: #0b2360;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Subtle grid background for hero (replaces inline data-URI) */
  .hero-grid {
    background-image: linear-gradient(to right, #f1f5f9 1px, transparent 1px),
      linear-gradient(to bottom, #f1f5f9 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Section spacing for navbar */
  section {
    scroll-margin-top: 80px;
  }

  /* Keep scrollbar space stable to avoid horizontal shift */
  :global([data-pricing-table-wrapper]) {
    overflow-y: hidden;
    scrollbar-gutter: stable;
  }

  :global([data-extra-row]) {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  :global([data-extra-row].is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Table responsive styles */
  @media (max-width: 768px) {
    table {
      font-size: 0.875rem;
    }

    th,
    td {
      padding: 0.5rem 0.25rem;
    }
  }
</style>

<script>
  // @ts-nocheck
  // Dynamic pricing & i18n for pricing table
  document.addEventListener("DOMContentLoaded", () => {
    const currencySelect = document.getElementById("currency-select");
    const billingToggle = document.getElementById("billing-toggle");

    const getLangFromPath = () => {
      const path = location.pathname.toLowerCase();
      if (path.startsWith("/en")) return "en";
      if (path.startsWith("/es")) return "es";
      if (path.startsWith("/de")) return "de";
      return "pl";
    };

    const lang = getLangFromPath();
    // Default currency: use EUR on English route
    if (
      lang === "en" &&
      currencySelect &&
      currencySelect instanceof HTMLSelectElement
    ) {
      currencySelect.value = "EUR";
    }

    const dataNode = document.getElementById("pricing-data");
    const encodedCopy = dataNode?.getAttribute("data-copy") || "%7B%7D";
    const encodedAmounts = dataNode?.getAttribute("data-amounts") || "%7B%7D";

    /** @type {Record<string, any>} */
    const copy = JSON.parse(decodeURIComponent(encodedCopy));
    /** @type {Record<string, any>} */
    const amounts = JSON.parse(decodeURIComponent(encodedAmounts));

    const applyCopy = () => {
      const dict = copy?.[lang] || copy?.pl || {};
      document.querySelectorAll("[data-i18n]").forEach((el) => {
        const key = el.getAttribute("data-i18n") || "";
        const value = key
          .split(".")
          .reduce((acc, k) => (acc ? acc[k] : undefined), dict);
        if (typeof value === "string") el.textContent = value;
      });
    };

    /**
     * @param {"PLN" | "USD" | "EUR"} currency
     * @param {number} value
     * @returns {string}
     */
    function formatCurrency(currency, value) {
      const meta = amounts?.meta?.currencySymbols?.[currency];
      const num = new Intl.NumberFormat(undefined, {
        maximumFractionDigits: 0,
      }).format(value);
      if (!meta) return num;
      const sep = typeof meta.separator === "string" ? meta.separator : " ";
      return meta.position === "prefix"
        ? `${meta.symbol}${sep}${num}`
        : `${num}${sep}${meta.symbol}`;
    }

    const applyPrices = () => {
      /** @type {"PLN" | "USD" | "EUR"} */
      const currency =
        currencySelect && currencySelect instanceof HTMLSelectElement
          ? currencySelect.value
          : "PLN";
      const isYearly = !!(
        billingToggle &&
        billingToggle instanceof HTMLInputElement &&
        billingToggle.checked
      );
      const cur = amounts?.[currency] || {};
      const perMonthKey = isYearly ? "yearlyPerMonth" : "monthly";
      const originalKey = isYearly ? "yearlyOriginalTotal" : "monthlyOriginal";

      document.querySelectorAll(".price").forEach((el) => {
        const plan = el.getAttribute("data-plan");
        if (!plan || !cur[plan]) return;
        const value = cur[plan][perMonthKey];
        el.textContent = formatCurrency(currency, value);
      });

      const perMonthText = copy?.[lang]?.labels?.per_month || "/month";
      const perYearText = copy?.[lang]?.labels?.per_year || "per year";

      document.querySelectorAll(".price-original").forEach((el) => {
        const plan = el.getAttribute("data-plan");
        if (!plan || !cur[plan]) return;
        const value = cur[plan][originalKey];
        if (isYearly) {
          el.textContent = `${formatCurrency(currency, value)} ${perYearText}`;
        } else {
          el.textContent = `${formatCurrency(currency, value)} ${perMonthText}`;
        }
      });

      document.querySelectorAll(".save-note").forEach((el) => {
        const plan = el.getAttribute("data-plan");
        if (!plan || !cur[plan]) return;
        if (isYearly) {
          const total = cur[plan].yearlyTotal;
          const template =
            copy?.[lang]?.labels?.pay_year ||
            copy?.pl?.labels?.pay_year ||
            "{total}";
          el.textContent = template.replace(
            "{total}",
            formatCurrency(currency, total),
          );
        } else {
          const base = cur[plan].monthlyOriginal;
          const now = cur[plan].monthly;
          if (!base || base <= 0) {
            el.textContent = "";
            return;
          }
          const pct = Math.round(((base - now) / base) * 100);
          const template =
            copy?.[lang]?.labels?.save ||
            copy?.pl?.labels?.save ||
            "{percent}%";
          el.textContent = template.replace("{percent}", String(pct));
        }
      });
    };

    applyCopy();
    applyPrices();

    billingToggle?.addEventListener("change", applyPrices);
    currencySelect?.addEventListener("change", applyPrices);
  });
</script>
