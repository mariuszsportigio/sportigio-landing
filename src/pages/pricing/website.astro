---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PricingIncludes from "../../components/PricingIncludes.astro";
import HowToStart from "../../components/HowToStart.astro";
import { defaultLanguage, getTranslations, type Language } from "../../i18n";
import globeIcon from "lucide-static/icons/globe.svg?raw";
import sparklesIcon from "lucide-static/icons/sparkles.svg?raw";
import checkIcon from "lucide-static/icons/check.svg?raw";

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props as Props;

const translations = getTranslations(lang) as any;
const fallbackTranslations =
  lang === defaultLanguage
    ? translations
    : (getTranslations(defaultLanguage) as any);

const pageCopy =
  (translations?.pages?.pricingWebsite as any) ??
  (fallbackTranslations?.pages?.pricingWebsite as any) ??
  {};
const fallbackPageCopy =
  (fallbackTranslations?.pages?.pricingWebsite as any) ?? {};
const pricingText =
  translations?.pricing ?? fallbackTranslations?.pricing ?? {};

const currencyLabel =
  pricingText.currency ??
  pricingText.hero?.currencyLabel ??
  fallbackTranslations?.pricing?.currency ??
  fallbackTranslations?.pricing?.hero?.currencyLabel ??
  "Waluta:";
const monthlyLabel =
  pricingText.monthly ??
  pricingText.hero?.monthlyLabel ??
  fallbackTranslations?.pricing?.monthly ??
  fallbackTranslations?.pricing?.hero?.monthlyLabel ??
  "Miesięcznie";
const yearlyLabel =
  pricingText.yearly ??
  pricingText.hero?.yearlyLabel ??
  fallbackTranslations?.pricing?.yearly ??
  fallbackTranslations?.pricing?.hero?.yearlyLabel ??
  "Rocznie";
const saveBadgeText =
  pricingText.save_badge ??
  pricingText.hero?.saveBadge ??
  fallbackTranslations?.pricing?.save_badge ??
  fallbackTranslations?.pricing?.hero?.saveBadge ??
  "Oszczędź do 20%";

const defaultStandardCard = {
  badge: "WYBÓR KLUBÓW",
  name: "Strona Standard",
  tagline: "Wszystko czego potrzebujesz na start",
  price: "199 zł",
  priceSuffix: "/ mies.",
  priceNote: "Cena netto (+23% VAT)",
  features: [
    "Własna domena (twojklub.pl)",
    "Hosting i certyfikat SSL w cenie",
    "Responsywny szablon RWD",
    "Integracja z newsami i tabelami",
    "Galeria zdjęć i wideo",
    "Formularz kontaktowy",
  ],
  cta: "Wybierz Standard",
};

const defaultChampionCard = {
  badge: "Champion Website",
  name: "Champion Website",
  tagline: "Dedykowany projekt i wdrożenie",
  price: "Indywidualna wycena",
  features: [
    "Wszystko z pakietu Standard",
    "Indywidualny projekt graficzny",
    "Dedykowane podstrony i moduły",
    "Migracja treści z poprzedniej strony",
    "Zaawansowane integracje API",
    "Priorytetowe wsparcie techniczne",
  ],
  cta: "Zapytaj o wycenę",
};

const metaTitle =
  pageCopy?.meta?.title ??
  fallbackPageCopy?.meta?.title ??
  "Sportigio - Strona WWW dla Twojego klubu";
const heroBadge =
  pageCopy?.hero?.badge ??
  fallbackPageCopy?.hero?.badge ??
  "Add-on do platformy Sportigio";
const heroTitle =
  pageCopy?.hero?.title ??
  fallbackPageCopy?.hero?.title ??
  "Profesjonalna strona WWW dla Twojego klubu";
const heroSubtitle =
  pageCopy?.hero?.subtitle ??
  fallbackPageCopy?.hero?.subtitle ??
  "W pełni zintegrowana z platformą, responsywna i łatwa w obsłudze.";

const standardCard = {
  ...defaultStandardCard,
  ...(fallbackPageCopy?.cards?.standard ?? {}),
  ...(pageCopy?.cards?.standard ?? {}),
};
const championCard = {
  ...defaultChampionCard,
  ...(fallbackPageCopy?.cards?.champion ?? {}),
  ...(pageCopy?.cards?.champion ?? {}),
};
const currencySymbols = {
  PLN: { symbol: "zł", position: "suffix", separator: " ", code: "PLN" },
  USD: { symbol: "$", position: "prefix", separator: "", code: "USD" },
  EUR: { symbol: "€", position: "prefix", separator: "", code: "EUR" },
} as const;

type CurrencyKey = keyof typeof currencySymbols;

const websiteAmounts: Record<
  CurrencyKey,
  { monthly: number; yearlyPerMonth: number; yearlyTotal: number }
> = {
  PLN: { monthly: 199, yearlyPerMonth: 159, yearlyTotal: 1908 },
  USD: { monthly: 46, yearlyPerMonth: 37, yearlyTotal: 444 },
  EUR: { monthly: 41, yearlyPerMonth: 33, yearlyTotal: 396 },
};

const formatCurrency = (currency: CurrencyKey, value: number) => {
  const meta = currencySymbols[currency];
  const num = new Intl.NumberFormat(undefined, {
    maximumFractionDigits: 0,
  }).format(value);
  return meta.position === "prefix"
    ? `${meta.symbol}${meta.separator}${num}`
    : `${num}${meta.separator}${meta.symbol}`;
};

const defaultCurrency: CurrencyKey = lang === "en" ? "EUR" : "PLN";
const initialPrice = formatCurrency(
  defaultCurrency,
  websiteAmounts[defaultCurrency].monthly,
);
const monthlySuffix = standardCard.priceSuffix ?? "/ mies.";
const yearlySuffix = monthlySuffix;
const defaultYearlyTotalLabel =
  lang === "en" ? "Yearly: {total}" : "Rocznie: {total}";
const yearlyTotalLabel =
  pageCopy?.cards?.standard?.yearlyTotalLabel ??
  fallbackPageCopy?.cards?.standard?.yearlyTotalLabel ??
  defaultYearlyTotalLabel;

const standardFeatures =
  Array.isArray(standardCard.features) && standardCard.features.length > 0
    ? standardCard.features
    : defaultStandardCard.features;
const championFeatures =
  Array.isArray(championCard.features) && championCard.features.length > 0
    ? championCard.features
    : defaultChampionCard.features;

const contactHref = "mailto:hello@sportigio.com";
const championPriceNote =
  pageCopy?.cards?.champion?.priceNote ??
  fallbackPageCopy?.cards?.champion?.priceNote ??
  "";
---

<Layout title={metaTitle}>
  <Navbar lang={lang} activePage="pricing" />
  <div aria-hidden="true" class="h-16"></div>

  <main class="bg-white min-h-screen">
    <section
      class="bg-gradient-to-br from-[#0B2360] via-[#0B2360] to-[#00052E] text-white py-16 sm:py-20"
    >
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-5xl">
        <span
          class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-full bg-white/10 border border-white/20 backdrop-blur"
        >
          {heroBadge}
        </span>
        <h1
          class="mt-6 text-3xl sm:text-4xl lg:text-5xl font-bold font-poppins"
        >
          {heroTitle}
        </h1>
        <p class="mt-4 text-lg sm:text-xl text-blue-100">
          {heroSubtitle}
        </p>
      </div>
    </section>

    <div
      id="website-pricing-data"
      data-amounts={encodeURIComponent(JSON.stringify(websiteAmounts))}
      data-meta={encodeURIComponent(JSON.stringify({ currencySymbols }))}
      data-default-currency={defaultCurrency}
      data-monthly-suffix={monthlySuffix}
      data-yearly-suffix={yearlySuffix}
      data-yearly-total-label={encodeURIComponent(yearlyTotalLabel)}
      class="hidden"
    >
    </div>

    <section class="bg-gray-50 py-16 sm:py-20">
      <div
        class="container mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center gap-10"
      >
        <div class="w-full max-w-4xl">
          <div
            class="flex items-center justify-center flex-wrap gap-4 text-center"
          >
            <div class="flex items-center gap-3">
              <span class="text-gray-700 font-medium">{currencyLabel}</span>
              <select
                id="website-currency-select"
                class="bg-white border border-gray-300 rounded-lg px-3 py-2 text-gray-700"
              >
                <option value="PLN">PLN</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
              </select>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-gray-700 font-medium">{monthlyLabel}</span>
              <div class="relative">
                <input
                  type="checkbox"
                  id="website-billing-toggle"
                  class="sr-only"
                />
                <label
                  for="website-billing-toggle"
                  class="flex items-center cursor-pointer"
                >
                  <div class="relative">
                    <div class="block bg-gray-300 w-14 h-8 rounded-full"></div>
                    <div
                      class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full transition transform"
                    >
                    </div>
                  </div>
                </label>
              </div>
              <span class="text-gray-700 font-medium">{yearlyLabel}</span>
              <span
                class="bg-[#01DFEC] text-[#0B2360] px-3 py-1 rounded-full text-sm font-semibold"
              >
                {saveBadgeText}
              </span>
            </div>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2 max-w-3xl w-full">
          <!-- Standard Card -->
          <article
            class="relative bg-white rounded-2xl shadow-lg border border-[#0B2360]/20 p-6 sm:p-8 overflow-visible"
          >
            <div class="absolute left-1/2 -translate-x-1/2 -top-3">
              <span
                class="px-4 py-1.5 text-xs font-bold tracking-wider uppercase text-white bg-[#0B2360] rounded-full shadow-md whitespace-nowrap"
              >
                {standardCard.badge}
              </span>
            </div>
            <div class="flex items-center gap-3 mt-3">
              <div
                class="h-9 w-9 rounded-full bg-[#E6EDFF] text-[#0B2360] flex items-center justify-center shrink-0 [&>svg]:w-5 [&>svg]:h-5"
                set:html={globeIcon}
              />
              <div>
                <h2 class="text-xl font-bold text-[#0B2360]">
                  {standardCard.name}
                </h2>
                <p class="text-gray-500 text-sm">{standardCard.tagline}</p>
              </div>
            </div>
            <div class="mt-6">
              <div class="flex items-baseline gap-1 text-[#0B2360]">
                <span class="text-3xl sm:text-4xl font-bold" data-website-price
                  >{initialPrice}</span
                >
                <span
                  class="text-base font-medium text-gray-600"
                  data-website-price-suffix>{standardCard.priceSuffix}</span
                >
              </div>
              <p class="text-xs text-gray-400 mt-0.5">
                {standardCard.priceNote}
              </p>
              <p
                class="text-xs text-[#0B2360] mt-1 hidden"
                data-website-total-wrapper
              >
                <span data-website-total></span>
              </p>
            </div>
            <ul class="mt-6 space-y-2.5">
              {
                standardFeatures.map((feature: string) => (
                  <li class="flex items-start gap-2.5 text-gray-700">
                    <span
                      class="h-4 w-4 text-[#0B2360] mt-0.5 shrink-0 [&>svg]:w-4 [&>svg]:h-4"
                      set:html={checkIcon}
                    />
                    <span class="text-sm leading-relaxed">{feature}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-8">
              <a
                href={contactHref}
                class="inline-flex w-full items-center justify-center rounded-full bg-sportigio-gradient px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:translate-y-[-1px] hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#01DFEC]"
              >
                {standardCard.cta}
              </a>
            </div>
          </article>

          <!-- Champion Card -->
          <article
            class="relative rounded-2xl bg-gradient-to-br from-[#0B2360] via-[#0B1A50] to-[#00052E] overflow-hidden shadow-lg"
          >
            <div
              class="absolute -right-8 -top-8 h-32 w-32 rounded-full bg-[#01DFEC]/10 blur-2xl"
            >
            </div>
            <div class="relative p-6 sm:p-8 text-white">
              <div class="flex items-center gap-3">
                <div
                  class="h-9 w-9 rounded-full bg-[#01DFEC]/20 text-[#01DFEC] flex items-center justify-center shrink-0 [&>svg]:w-5 [&>svg]:h-5"
                  set:html={sparklesIcon}
                />
                <div>
                  <h2 class="text-xl font-bold">{championCard.name}</h2>
                  <p class="text-blue-200 text-sm">{championCard.tagline}</p>
                </div>
              </div>
              <div class="mt-6">
                <p class="text-3xl sm:text-4xl font-bold">
                  {championCard.price}
                </p>
              </div>
              <ul class="mt-6 space-y-2.5">
                {
                  championFeatures.map((feature: string) => (
                    <li class="flex items-start gap-2.5 text-blue-50">
                      <span
                        class="h-4 w-4 text-[#01DFEC] mt-0.5 shrink-0 [&>svg]:w-4 [&>svg]:h-4"
                        set:html={checkIcon}
                      />
                      <span class="text-sm leading-relaxed">{feature}</span>
                    </li>
                  ))
                }
              </ul>
              <div class="mt-8">
                <a
                  href={contactHref}
                  class="inline-flex w-full items-center justify-center rounded-full bg-[#01DFEC] px-5 py-2.5 text-sm font-semibold text-[#0B2360] shadow-md transition hover:translate-y-[-1px] hover:shadow-lg hover:bg-[#7BF3F7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  {championCard.cta}
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <PricingIncludes lang={lang} section="pricingWebsite" />

    <HowToStart lang={lang} />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const dataNode = document.getElementById("website-pricing-data");
      const currencySelect = document.getElementById("website-currency-select");
      const billingToggle = document.getElementById("website-billing-toggle");
      const toggleLabel = document.querySelector(
        '[for="website-billing-toggle"]',
      );
      const priceEl = document.querySelector("[data-website-price]");
      const suffixEl = document.querySelector("[data-website-price-suffix]");
      const totalWrapper = document.querySelector(
        "[data-website-total-wrapper]",
      );
      const totalEl = document.querySelector("[data-website-total]");

      if (!dataNode || !priceEl || !suffixEl) return;

      const amounts = JSON.parse(
        decodeURIComponent(dataNode.getAttribute("data-amounts") || "%7B%7D"),
      );
      const meta = JSON.parse(
        decodeURIComponent(dataNode.getAttribute("data-meta") || "%7B%7D"),
      );
      const defaultCurrency =
        dataNode.getAttribute("data-default-currency") || "PLN";
      const monthlySuffix =
        dataNode.getAttribute("data-monthly-suffix") || "/ mies.";
      const yearlySuffix =
        dataNode.getAttribute("data-yearly-suffix") || monthlySuffix;
      const yearlyTotalLabel = decodeURIComponent(
        dataNode.getAttribute("data-yearly-total-label") ||
          "Rocznie%3A%20%7Btotal%7D",
      );

      const formatCurrency = (currency, value) => {
        const symbol = meta?.currencySymbols?.[currency];
        const num = new Intl.NumberFormat(undefined, {
          maximumFractionDigits: 0,
        }).format(value || 0);

        if (!symbol) return `${num} ${currency}`;

        const separator =
          typeof symbol.separator === "string" ? symbol.separator : " ";
        return symbol.position === "prefix"
          ? `${symbol.symbol}${separator}${num}`
          : `${num}${separator}${symbol.symbol}`;
      };

      const applyPrice = () => {
        const currency =
          currencySelect && currencySelect instanceof HTMLSelectElement
            ? currencySelect.value
            : defaultCurrency;
        const isYearly =
          billingToggle &&
          billingToggle instanceof HTMLInputElement &&
          billingToggle.checked;

        const cur = amounts?.[currency];
        if (!cur) return;

        const priceValue = isYearly ? cur.yearlyPerMonth : cur.monthly;
        priceEl.textContent = formatCurrency(currency, priceValue);
        suffixEl.textContent = isYearly ? yearlySuffix : monthlySuffix;

        if (totalWrapper && totalEl) {
          if (isYearly && typeof cur.yearlyTotal === "number") {
            totalEl.textContent = yearlyTotalLabel.replace(
              "{total}",
              formatCurrency(currency, cur.yearlyTotal),
            );
            totalWrapper.classList.remove("hidden");
          } else {
            totalWrapper.classList.add("hidden");
            totalEl.textContent = "";
          }
        }
      };

      if (currencySelect && currencySelect instanceof HTMLSelectElement) {
        currencySelect.value = defaultCurrency;
        currencySelect.addEventListener("change", applyPrice);
      }

      if (billingToggle && billingToggle instanceof HTMLInputElement) {
        const dot = toggleLabel?.querySelector(".dot");

        const updateDot = () => {
          if (dot instanceof HTMLElement) {
            dot.style.transform = billingToggle.checked
              ? "translateX(1.5rem)"
              : "translateX(0)";
          }
        };

        billingToggle.addEventListener("change", () => {
          updateDot();
          applyPrice();
        });

        updateDot();
      }

      applyPrice();
    });
  </script>

  <Footer lang={lang} />
</Layout>
